# 1. Copy this file to ".env"  ->  cp .env.example .env
# 2. Paste your real key below.
# 3. The .env file is git-ignored and will NOT be uploaded to GitHub.

OPENAI_API_KEY=sk-your-key-here

# --- Optional: use Anthropic (Claude) instead of OpenAI ---
# Install:  pip install llama-index-llms-anthropic
# Then set the key here and switch the LLM in src/config.py + src/query.py.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
